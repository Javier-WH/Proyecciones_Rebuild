# ═══════════════════════════════════════════════════════════════════════
#  Configuración del backend — Sistema de Proyecciones Académicas UPTLL
# ═══════════════════════════════════════════════════════════════════════
#  INSTRUCCIONES PARA EL DEPLOY (servidor del tecnológico):
#    1. Copia este archivo como `.env` en esta misma carpeta (backend/).
#    2. Cambia SOLO los valores entre los marcadores «CAMBIAR» — el resto
#       funciona tal cual para un deploy local de un solo proceso.
#    3. Compila el frontend (frontend: npm run build) y el backend lo
#       servirá automáticamente en el mismo puerto.
# ═══════════════════════════════════════════════════════════════════════

# ── Servidor ────────────────────────────────────────────────────────────
# Puerto donde escucha la API (y la web compilada si existe frontend/dist).
PORT=4000

# Interfaz de escucha. 0.0.0.0 = accesible desde otras PCs de la red del
# instituto; 127.0.0.1 = solo esta máquina.
HOST=0.0.0.0

# 'production' en el servidor real — activa las validaciones estrictas
# (JWT_SECRET obligatorio, CORS restringido).
NODE_ENV=production

# ── Seguridad ───────────────────────────────────────────────────────────
# «CAMBIAR» — Secreto para firmar los tokens de sesión. OBLIGATORIO en
# producción: el servidor no arranca sin él.
# Genera uno largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Orígenes permitidos para CORS (separados por comas, sin espacios).
# En deploy de un solo proceso (backend sirve la web) puede quedar VACÍO:
# las peticiones same-origin no necesitan CORS.
# Solo agrega orígenes si el frontend se sirve desde OTRO host/puerto, ej:
#   CORS_ORIGINS=http://192.168.1.50:3000
CORS_ORIGINS=

# Clave para integraciones externas de solo lectura (app de asistencias,
# pantallas de consulta). Si se deja vacía, /api/externo responde 503
# (deshabilitado) — es seguro dejarlo vacío si no se usa.
# Genera una larga y aleatoria si la necesitas:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTERNAL_API_KEY=

# ── Base de datos (MariaDB / MySQL) ────────────────────────────────────
# «CAMBIAR» según el servidor de base de datos del instituto.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=proyecciones_uptll

# ── SAGA (catálogos académicos) ─────────────────────────────────────────
# «CAMBIAR» — URL y credenciales del sistema SAGA del instituto.
# Si SAGA está en el mismo servidor, http://127.0.0.1:8000/api/v1
API_URL=http://127.0.0.1:8000/api/v1
API_USER=defaultAdmin
API_PASSWORD=123456789

# ── Frontend servido por el backend ────────────────────────────────────
# 1 (u omitir) = el backend sirve frontend/dist si existe → un solo proceso.
# 0 = no servir la web desde el backend (deploy separado).
SERVE_FRONTEND=1
